set -e
ROOT="${DPKG_ROOT:-}"
case "$1" in
    configure)
        if [ -z "$ROOT" ] && command -v py3compile >/dev/null 2>&1; then
            py3compile -p anonyhost /opt/anonyhost || true
        fi
        # first installation only (an upgrade has a previous version in $2)
        if [ -z "${2:-}" ] && [ -r "$ROOT/usr/lib/anonyhost/system-services.sh" ]; then
            . "$ROOT/usr/lib/anonyhost/system-services.sh"
            disable_defaults || true
        fi
        ;;
esac
exit 0
