set -e
ROOT="${DPKG_ROOT:-}"
case "$1" in
    remove|purge|abort-install|disappear)
        rm -rf "$ROOT/opt/anonyhost/__pycache__" "$ROOT"/opt/anonyhost/*/__pycache__ 2>/dev/null || true
        # dpkg tries to remove folders before this script runs, so remove the ones that are empty now
        find "$ROOT/opt/anonyhost" -depth -type d -empty -delete 2>/dev/null || true
        ;;
esac
case "$1" in
    purge)
        # only AnonyHost's own bookkeeping. Websites, settings and onion keys in users' home folders are never removed.
        rm -rf "$ROOT/var/lib/anonyhost"
        rmdir "$ROOT/etc/anonyhost" 2>/dev/null || true
        ;;
esac
exit 0
